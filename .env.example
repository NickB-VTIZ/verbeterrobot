# Beheerderswachtwoord (verplicht — geeft toegang tot het beheerscherm)
ADMIN_PASSWORD=verander-dit-beheerwachtwoord

# Startwachtwoord voor leerkrachten (de beheerder kan dit later in het beheer wijzigen)
TEACHER_PASSWORD=verander-dit-leerkrachtenwachtwoord
# (APP_PASSWORD wordt nog steeds ondersteund als alternatief voor TEACHER_PASSWORD)

# Startwaarden voor Omniroute — aanpasbaar in het beheerscherm
# (wat in het beheer is opgeslagen, heeft voorrang op deze waarden)
OMNIROUTE_BASE_URL=https://omniroute.example.com/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=gpt-4o

# Server
PORT=3010
MAX_FILE_MB=20

# Map waar de beheerinstellingen bewaard worden (in Docker: volume /app/data)
# DATA_DIR=./data
